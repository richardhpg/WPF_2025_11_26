<Window x:Class="WpfGitGyak.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WpfGitGyak"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">
    <Grid>
        <Label Content="WPF Git Gyakorlás" HorizontalAlignment="Center" FontSize="16" />
        <Button x:Name="btnMessage" HorizontalAlignment="Center" VerticalAlignment="Bottom" FontSize="16" Content="Message" Margin="0, 0, 0, 25" Height="50" Width="150" Click="btnMessage_Click"/>
    </Grid>
</Window>
